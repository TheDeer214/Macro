local function appendLog(msg, msgType, isHistory)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 18)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.Code
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextWrapped = true

	local timestamp = isHistory and "[--:--:--]" or "[" .. os.date("%H:%M:%S") .. "]"
	lbl.Text = timestamp .. " -- " .. msg
	
	if msgType == Enum.MessageType.MessageWarning then
		lbl.TextColor3 = Color3.fromRGB(241, 196, 15)
	elseif msgType == Enum.MessageType.MessageError then
		lbl.TextColor3 = Color3.fromRGB(231, 76, 60)
	else
		lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
	end
	lbl.Parent = consoleScroll
end

