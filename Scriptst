			TweenService:Create(mainFrame, tweenInfo, {Position = openPosition}):Play()
		else
			local tweenOut = TweenService:Create(mainFrame, tweenInfo, {Position = closedPosition})
			tweenOut:Play()
			tweenOut.Completed:Connect(function()
				if not isGuiVisible then mainFrame.Visible = false end
			end)
		end
	end
end)

