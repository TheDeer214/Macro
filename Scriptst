-- 🟥 Dupe check
if getgenv().MacroSuiteRunning then
    getgenv().SharedMacroNotification("ERROR", "DUPLICATE TERMINATED", "rbxassetid://94101711880666", "rbxassetid://97265398503265", 3)
    warn("[DUPLICATE TERMINATED].")

    return
end

getgenv().MacroSuiteRunning = true

-- 👀 Main script starts here
print("V.V")

local HttpService = game:GetService("HttpService")
local fileName = "MacroSuiteStats.json"

-- Initialize
_G.MacroStats = {
    ExecutionCount = 0
}

-- Load
if pcall(function() readfile(fileName) end) then
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)
    if success and type(decoded) == "table" then
        for k, v in pairs(decoded) do
            _G.MacroStats[k] = v
        end
    end
end

-- Increment
_G.MacroStats.ExecutionCount = (_G.MacroStats.ExecutionCount or 0) + 1

-- Saving
pcall(function()
    writefile(fileName, HttpService:JSONEncode(_G.MacroStats))
end)

-- 🟩 Printing
print("[MACROSTRUCT]")
print("[Script ID: " .. _G.MacroStats.ExecutionCount .. "]")

-- Start Notification
local myDisplayName = game:GetService("Players").LocalPlayer.DisplayName

getgenv().SharedMacroNotification("Macrostruct", "Loaded successfully!", "rbxassetid://12433138134", "rbxassetid://9114302479", 5)
task.wait(1)
getgenv().SharedMacroNotification("Welcome!", myDisplayName, "", "rbxassetid://15675016548", 5)
