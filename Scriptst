-- 🟩 Startup
print("V.A")

local HttpService = game:GetService("HttpService")
local fileName = "MacroSuiteStats.json"

-- Initialize
_G.MacroStats = {
    ExecutionCount = 0
}

-- Load
if pcall(function() readfile(fileName) end) then
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)
    if success and type(decoded) == "table" then
        for k, v in pairs(decoded) do
            _G.MacroStats[k] = v
        end
    end
end

-- Increment
_G.MacroStats.ExecutionCount = (_G.MacroStats.ExecutionCount or 0) + 1

-- Saving
pcall(function()
    writefile(fileName, HttpService:JSONEncode(_G.MacroStats))
end)

-- ID
print("[Script ID: " .. _G.MacroStats.ExecutionCount .. "]")

-- Notification setup
local function sendMacroNotification(titleText, bodyText, iconId, duration)
    task.spawn(function()
        for _ = 1, 10 do
            local success = pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = titleText,
                    Text = bodyText,
                    Icon = iconId or "",
                    Duration = duration or 5,
                })
            end)
            if success then break end
            task.wait(0.5)
        end
    end)
end

-- Fire notification
sendMacroNotification(
    "Macro Suite", 
    "Successfully loaded! Execution #" .. _G.MacroStats.ExecutionCount, 
    "rbxassetid://6023426915", 
    5
)
-- Printing
print("[MACROSUITE]")
print("[LOADED]")
