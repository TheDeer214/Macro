-- 1. Load existing macros from file
local function loadMacros()
	if pcall(function() return isfile and isfile(macroFileName) end) and isfile(macroFileName) then
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(readfile(macroFileName))
		end)
		if success and type(decoded) == "table" then
			savedMacros = decoded
		end
	end
end

loadMacros()

-- 2. Save macros to file
local function saveMacros()
	local success, encoded = pcall(function()
		return HttpService:JSONEncode(savedMacros)
	end)
	if success and writefile then
		writefile(macroFileName, encoded)
	end
end

