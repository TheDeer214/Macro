-- 🟩 Startup
print("V.Q")

local HttpService = game:GetService("HttpService")
local fileName = "MacroSuiteStats.json"

-- Initialize
_G.MacroStats = {
    ExecutionCount = 0
}

-- Load
if pcall(function() readfile(fileName) end) then
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)
    if success and type(decoded) == "table" then
        for k, v in pairs(decoded) do
            _G.MacroStats[k] = v
        end
    end
end

-- Increment
_G.MacroStats.ExecutionCount = (_G.MacroStats.ExecutionCount or 0) + 1

-- Saving
pcall(function()
    writefile(fileName, HttpService:JSONEncode(_G.MacroStats))
end)

-- 🟩 ID
print("[Script ID: " .. _G.MacroStats.ExecutionCount .. "]")

-- Notification setup
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "NotificationGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- @param title string: The header of the notification
-- @param message string: The body text
-- @param iconId string? (Optional): The rbxassetid:// string for the image icon (can be nil or "")
-- @param duration number? (Optional): How long the notification stays visible (default: 3)
local function ShowNotification(title, message, iconId, duration)
	duration = duration or 3
	local hasIcon = iconId and iconId ~= ""

	local notifFrame = Instance.new("Frame")
	notifFrame.Name = "NotificationItem"
	notifFrame.Size = UDim2.new(0, 260, 0, 70)
	notifFrame.Position = UDim2.new(1, 10, 0.05, 0)
	notifFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	notifFrame.BorderSizePixel = 0
	notifFrame.Parent = screenGui

	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 8)
	uiCorner.Parent = notifFrame

	if hasIcon then
		local icon = Instance.new("ImageLabel")
		icon.Name = "Icon"
		icon.Size = UDim2.new(0, 45, 0, 45)
		icon.Position = UDim2.new(0, 12, 0, 12)
		icon.BackgroundTransparency = 1
		icon.Image = iconId
		icon.Parent = notifFrame

		local iconCorner = Instance.new("UICorner")
		iconCorner.CornerRadius = UDim.new(1, 0)
		iconCorner.Parent = icon
	end

	local textXPos = hasIcon and 68 or 15
	local textWidth = hasIcon and 180 or 230

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(0, textWidth, 0, 20)
	titleLabel.Position = UDim2.new(0, textXPos, 0, 12)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Text = title
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextSize = 14
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = notifFrame

	local messageLabel = Instance.new("TextLabel")
	messageLabel.Name = "Message"
	messageLabel.Size = UDim2.new(0, textWidth, 0, 25)
	messageLabel.Position = UDim2.new(0, textXPos, 0, 32)
	messageLabel.BackgroundTransparency = 1
	messageLabel.Font = Enum.Font.Gotham
	messageLabel.Text = message
	messageLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	messageLabel.TextSize = 12
	messageLabel.TextXAlignment = Enum.TextXAlignment.Left
	messageLabel.TextWrapped = true
	messageLabel.Parent = notifFrame

	local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local slideInGoal = {Position = UDim2.new(1, -270, 0.05, 0)}
	local slideOutGoal = {Position = UDim2.new(1, 10, 0.05, 0)}

	local tweenIn = TweenService:Create(notifFrame, tweenInfo, slideInGoal)
	tweenIn:Play()

	task.delay(duration, function()
		local tweenOut = TweenService:Create(notifFrame, tweenInfo, slideOutGoal)
		tweenOut:Play()
		
		tweenOut.Completed:Connect(function()
			notifFrame:Destroy()
		end)
	end)
end

-- 🟩 Fire notification
ShowNotification("MacroSuite", "Successfully loaded!", "rbxassetid://6023426915", 5)


-- 🟩 Printing
print("[MACROSUITE]")
print("[LOADED]")
